# SunShade Links Environment Variables (Local / Staging Template)
# Copy to .env or configure in Cloudflare / GitHub Actions secrets. NEVER commit real secrets.

# Cloudflare Infrastructure Provisioning & Deployments
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ZONE_ID=your-sunshade-icu-zone-id

# Supabase Platform (Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Origins & Routing
DASHBOARD_ORIGIN=https://sunshade-links.pages.dev
LINKS_API_URL=https://links.sunshade.icu
MASTER_API_KEY=your-sunshade-master-api-key
